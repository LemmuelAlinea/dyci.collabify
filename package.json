{
  "name": "collabify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "db": "node scripts/db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test && node scripts/contrast.mjs && node scripts/a11y-names.mjs && node scripts/schema-drift.mjs",
    "docs": "node scripts/report-pdf.mjs && node scripts/report-pdf.mjs docs/evaluation-questionnaire.html && node scripts/questionnaire-docx.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "docx": "^9.7.1",
    "dotenv": "^17.2.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "pg": "^8.16.3",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "safari >= 16.4",
    "firefox >= 128",
    "not dead"
  ]
}
